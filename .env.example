# Copy to .env. Never commit the real .env or send tokens in chat.
QROUTE_DATABASE_URL=sqlite:///var/jobs.db
QROUTE_MAX_DELIVERIES=15
QROUTE_MAX_VEHICLES=5
QROUTE_MAX_SOLVER_SECONDS=30
QROUTE_MAX_PLANNING_SECONDS=120
QROUTE_MAX_MEMORY_MB=1024
QROUTE_QUEUE_CAPACITY=100
QROUTE_OWNER_QUEUE_CAPACITY=20
QROUTE_OWNER_SUBMISSIONS_PER_MINUTE=10
QROUTE_OWNER_STORAGE_BYTES=32000000
QROUTE_STORAGE_BYTES=256000000
QROUTE_MAX_SNAPSHOT_BYTES=4000000
QROUTE_MIN_FREE_DISK_MB=256
QROUTE_QUEUE_TIMEOUT_SECONDS=300
QROUTE_RETENTION_SECONDS=86400
QROUTE_NETWORK_MODE=false
# In network mode, set this to a JSON array of the public hostnames served by the proxy.
QROUTE_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
# Required for network mode. Generate a unique random >=24-character token per integrator.
QROUTE_AUTH_TOKENS={}
ORS_API_KEY=
QROUTE_ORS_BASE_URL=https://api.heigit.org/openrouteservice
QROUTE_ORS_LEDGER_PATH=var/ors.sqlite
# Disabled until storage/caching conditions have been reviewed.
QROUTE_ORS_CACHE_TTL=0
QROUTE_ORS_MATRIX_DAILY=400
QROUTE_ORS_MATRIX_MINUTE=30
QROUTE_ORS_DIRECTIONS_DAILY=1600
QROUTE_ORS_DIRECTIONS_MINUTE=30
QROUTE_ORS_SNAP_DAILY=1600
QROUTE_ORS_SNAP_MINUTE=60
QROUTE_ORS_OWNER_QUOTA_FRACTION=0.25
